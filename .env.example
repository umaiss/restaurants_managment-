# App port (npm start / npm run dev). Avoid setting PORT in your global shell —
# the server resolves PORT first, so a global PORT shadows E2E_PORT during test runs.
PORT=3000
# E2E test server port (default 3100). Each parallel Bolt gets its own: 4100, 5100, 6100, 7100.
E2E_PORT=3100
DB_FILE=table-order.db
